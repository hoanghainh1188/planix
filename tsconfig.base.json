{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",

    // CLAUDE.md §3 — strict tuyệt đối, không `any`, không `as` nếu không có lý do.
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    // Bắt buộc: scheduler và CPM đọc mảng theo index rất nhiều (§7.3, §7.4).
    // Không bật cờ này thì `arr[i]` bị coi là luôn tồn tại — nguồn lỗi im lặng.
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}

    "exceljs": "^4.4.0",
    "luxon": "^3.7.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.5"
  }

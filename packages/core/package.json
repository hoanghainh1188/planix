{
  "name": "@planix/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Engine thu\u1ea7n: schema, importer, calendar, dependency, scheduler, validator, excel. Kh\u00f4ng ph\u1ee5 thu\u1ed9c web (SPEC.md \u00a73.3).",

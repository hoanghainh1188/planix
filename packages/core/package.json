{
  "name": "@planix/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Engine thuần: schema, importer, calendar, dependency, scheduler, validator, excel. Không phụ thuộc web (SPEC.md §3.3).",
  "exports": {
    ".": "./dist/index.js",
